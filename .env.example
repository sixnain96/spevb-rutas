# SEVB 4.13.1 · plantilla de configuración. Copia este archivo como .env (nunca lo publiques ni lo incluyas en un ZIP).
# La matriz completa (propósito, valor predeterminado, modo de arranque, sensibilidad) está en docs/CONFIGURACION.md.
# Los valores de esta plantilla son SEGUROS por defecto: editor apagado y servidor solo en 127.0.0.1.

# ---- Base de datos --------------------------------------------------------------------------------
# SENSIBLE. Obligatoria. Define una clave propia (por ejemplo: openssl rand -hex 24).
DB_PASSWORD=CAMBIA_ESTA_CLAVE_ANTES_DE_ARRANCAR
# Solo arranque con PowerShell/Maven (en Docker la URL y el usuario son fijos: ver docs/CONFIGURACION.md).
# DB_URL=jdbc:postgresql://localhost:5432/spevb
# DB_USER=spevb

# ---- Red y administración -------------------------------------------------------------------------
# Solo escucha en este equipo. En Docker se publica únicamente en 127.0.0.1 (compose.app.yml) o detrás de Caddy (compose.prod.yml).
SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8080
# Editor/administración APAGADO por defecto. Para activarlo: EDITOR_ENABLED=true y EDITOR_TOKEN de al menos 32 caracteres.
EDITOR_ENABLED=false
# SENSIBLE. Obligatoria solo si EDITOR_ENABLED=true.
# EDITOR_TOKEN=CAMBIA_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES
# Limitador de solicitudes por cliente (true/false).
# LIMITE_SOLICITUDES=true
# Correos (separados por coma) que ven el editor sin escribir la clave; deben entrar con Google. Es un dato personal.
# ADMIN_CORREOS=tucorreo@example.org
# ID de cliente de Google (público; ver docs/GOOGLE.md). Sin esto el botón de Google no aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ---- Datos de demostración ------------------------------------------------------------------------
# true = carga las 4 rutas DEMO (db/demo) al arrancar. SOLO desarrollo y pruebas. Producción lo fuerza a false.
DEMO_DATA=true

# ---- Búsqueda de direcciones y lugares (4.14: EXCLUSIVAMENTE Google) ----------------------------------
# SENSIBLE. Clave de Google Maps Platform para Places API (New): autocompletado, búsqueda de texto y detalle del lugar. Se usa SOLO desde Java
# (nunca llega al navegador). Sin esta clave la búsqueda de direcciones queda apagada y la interfaz lo dice; elegir en el mapa y el GPS siguen funcionando.
# Requiere facturación en Google Cloud: restringe la clave a «Places API (New)», fija un presupuesto con alertas y no la publiques. Ver docs/GOOGLE-MAPS.md.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_URL=https://places.googleapis.com
# Nominatim y ArcGIS NO participan en ninguna búsqueda del pasajero. Se dejan vacíos/apagados a propósito:
# GEOCODER_URL=
# GEOCODER_REVERSE_URL=
GEOCODER_USER_AGENT=SEVB-Rutas/4.10
# ArcGIS: heredado y SIN USO en la búsqueda del pasajero desde 4.14 (déjalo vacío; no se llama a ArcGIS para resolver direcciones).
# SENSIBLE si algún día se usara: credencial de ArcGIS, solo desde Java.
# ARCGIS_API_KEY=
# ARCGIS_GEOCODE_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
# Importaciones automáticas de direcciones y lugares: APAGADAS (la búsqueda ya no usa esas bases). La red vial y peatonal (OVERPASS_URLS, RED_*) sigue activa.
VILLAVO_CATASTRO_URL=https://services7.arcgis.com/c0V1cyhKZwmv8Gtf/ArcGIS/rest/services/U_TERRENO/FeatureServer/1/query
DIRECCIONES_IMPORT_AL_ARRANCAR=false
DIRECCIONES_REFRESCO_DIAS=30
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM_IMPORT_AL_ARRANCAR=false
# OSM_REFRESCO_DIAS=30

# ---- Caminata ---------------------------------------------------------------------------------------
WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# RED_PEATONAL_HABILITADA=true
# RED_PEATONAL_ARCHIVO=data/red-peatonal.bin.gz
# RED_PEATONAL_REFRESCO_DIAS=60

# ---- Red vial para buses (ajuste de recorridos) ------------------------------------------------------
# RED_VIAL_HABILITADA=true
# RED_VIAL_ARCHIVO=data/red-vial-bus.json.gz
# RED_VIAL_REFRESCO_DIAS=60
# RED_VIAL_MAX_SNAP_METROS=30
# BUS_MATCHING_URL=

# ---- Límites de la ciudad (normalmente no se cambian) ---------------------------------------------
# CITY_MIN_LAT=3.95
# CITY_MAX_LAT=4.35
# CITY_MIN_LNG=-73.85
# CITY_MAX_LNG=-73.45

# ---- Solo producción (compose.prod.yml) -----------------------------------------------------------
# Dominio público que apunta a la IP del servidor (registro A en el DNS). Obligatorio en producción.
# DOMINIO=rutas.midominio.com
# Memoria de Java; en un servidor de 4 GB sirve el valor por defecto (máx. 1,5 GB).
# JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseG1GC
