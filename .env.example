# Copia este archivo como .env. No publiques .env.
DB_PASSWORD=CAMBIA_ESTA_CLAVE_ANTES_DE_ARRANCAR

# Administración de recorridos y del catálogo local.
EDITOR_ENABLED=true
EDITOR_TOKEN=CAMBIA_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES

# Búsqueda de direcciones reales en Villavicencio mediante Nominatim/OpenStreetMap.
# El servicio público es adecuado para búsquedas manuales y exige uso moderado.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=SPEVB-Rutas-USTA/3.0

# Opcional. Normalmente no necesitas cambiar estos límites.
CITY_MIN_LAT=3.95
CITY_MAX_LAT=4.35
CITY_MIN_LNG=-73.85
CITY_MAX_LNG=-73.45

# Fuente municipal gratuita (URL de consulta de predios; se puede desactivar dejando vacío).
VILLAVO_CATASTRO_URL=https://services7.arcgis.com/c0V1cyhKZwmv8Gtf/ArcGIS/rest/services/U_TERRENO/FeatureServer/1/query
# Opcional: credencial de ArcGIS Location Platform, se consulta desde Java.
# ARCGIS_API_KEY=INTRODUCE_TU_CLAVE_REAL
# ARCGIS_GEOCODE_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates

# Inicio de sesión con Google (opcional). Sin esto el botón no aparece. Cómo obtenerlo: docs/GOOGLE.md
# GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# Base propia de direcciones: importa el catastro de Villavicencio la primera vez (≈ 5 min, en segundo plano).
# Ponlo en false para desactivar la importación automática.
DIRECCIONES_IMPORT_AL_ARRANCAR=true
DIRECCIONES_REFRESCO_DIAS=30

# ---- Solo para producción (compose.prod.yml) ----
# Dominio público que apunta a la IP del servidor (registro A en el DNS).
# DOMINIO=rutas.midominio.com
# En producción deja el editor apagado salvo que lo necesites y proteges el acceso.
# EDITOR_ENABLED=false
# Memoria de Java; en un servidor de 4 GB sirve el valor por defecto (máx. 1,5 GB).
# JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseG1GC
