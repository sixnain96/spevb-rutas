'use strict';
/* Comodidad de uso (4.14): mapa de noche automático y tamaño de la letra. Los dos se guardan en este dispositivo (Spevb.Ajustes) y se pueden cambiar
   desde el menú ☰ → «Pantalla». Nada de esto toca la lógica de rutas: solo añade una clase y un atributo al <html> que usa el CSS. */
(() => {
    const A = () => window.Spevb && window.Spevb.Ajustes;
    const MODOS = ['auto', 'claro', 'oscuro'], LETRAS = ['normal', 'grande', 'enorme'];
    /** De noche: de 6:30 p. m. a 5:30 a. m. (hora del dispositivo; en Villavicencio anochece hacia las 6 p. m.). */
    const esNoche = (fecha = new Date()) => { const m = fecha.getHours() * 60 + fecha.getMinutes(); return m >= 18 * 60 + 30 || m < 5 * 60 + 30; };
    const modo = () => { const v = A() && A().get('mapaNoche'); return MODOS.includes(v) ? v : 'auto'; };
    const letra = () => { const v = A() && A().get('letra'); return LETRAS.includes(v) ? v : 'normal'; };

    function aplicar() {
        const h = document.documentElement, m = modo();
        h.classList.toggle('mapa-noche', m === 'oscuro' || (m === 'auto' && esNoche()));
        h.dataset.letra = letra();
        document.querySelectorAll('select[data-confort="mapaNoche"]').forEach((s) => { if (s.value !== m) s.value = m; });
        document.querySelectorAll('button[data-letra]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.letra === letra())));
    }
    // ---- Voz del modo viaje (4.14): una sola decisión, recordada; se cambia en el menú ☰ → Pantalla.
    const VOZ_K = 'spevb-voz';
    const vozDisponible = () => 'speechSynthesis' in window && typeof window.SpeechSynthesisUtterance === 'function';
    const vozPreferencia = () => { try { const v = localStorage.getItem(VOZ_K); return v === 'si' ? true : v === 'no' ? false : null; } catch { return null; } };
    const vozFijar = (si) => { try { localStorage.setItem(VOZ_K, si ? 'si' : 'no'); } catch { /* sin almacenamiento */ } window.dispatchEvent(new CustomEvent('spevb-voz')); };
    /** La mejor voz en español disponible (Colombia, México, EE. UU., España…). */
    function vozElegida() {
        try {
            const voces = speechSynthesis.getVoices() || [];
            for (const pref of ['es-CO', 'es-MX', 'es-US', 'es-419', 'es-AR', 'es-ES']) { const v = voces.find((x) => (x.lang || '').replace('_', '-').toLowerCase() === pref.toLowerCase()); if (v) return v; }
            return voces.find((x) => /^es/i.test(x.lang || '')) || null;
        } catch { return null; }
    }
    /** Dice un texto despacio y claro (un poco más lento de lo normal, pensando en personas mayores). */
    function decir(texto) {
        if (!vozDisponible() || !texto) return false;
        try {
            speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(String(texto));
            const v = vozElegida();
            u.lang = v ? v.lang : 'es-CO'; if (v) u.voice = v;
            u.rate = 0.92; u.pitch = 1; u.volume = 1;
            speechSynthesis.speak(u);
            return true;
        } catch { return false; }
    }
    window.Spevb = window.Spevb || {};
    window.Spevb.Voz = { disponible: vozDisponible, preferencia: vozPreferencia, fijar: vozFijar, decir, probar: () => decir('Así te voy a avisar durante tu viaje: camina hasta el paradero, espera el bus y bájate cuando te diga.') };
    try { if (vozDisponible()) speechSynthesis.getVoices(); } catch { /* las voces cargan despacio en algunos navegadores */ }
    document.addEventListener('DOMContentLoaded', () => {
        const caja = document.getElementById('vozAjuste');
        if (caja) {
            caja.checked = vozPreferencia() === true;
            caja.addEventListener('change', () => vozFijar(caja.checked));
            window.addEventListener('spevb-voz', () => { caja.checked = vozPreferencia() === true; });
        }
        const probar = document.getElementById('vozProbarMenu');
        if (probar) probar.addEventListener('click', () => { if (!window.Spevb.Voz.probar() && window.Spevb.toast) window.Spevb.toast('Este teléfono no tiene voz disponible en el navegador.', { tipo: 'info', ms: 4000 }); });
        if (caja && !vozDisponible()) { caja.disabled = true; }
    });
    window.Spevb = window.Spevb || {};
    window.Spevb.Confort = { esNoche, aplicar };

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('select[data-confort="mapaNoche"]').forEach((s) => s.addEventListener('change', () => { if (A()) A().set('mapaNoche', s.value); aplicar(); }));
        document.querySelectorAll('button[data-letra]').forEach((b) => b.addEventListener('click', () => { if (A()) A().set('letra', b.dataset.letra); aplicar(); }));
        aplicar();
    });
    aplicar();
    setInterval(aplicar, 60000);        // al llegar la noche (o el día) el mapa cambia solo, sin recargar
})();
