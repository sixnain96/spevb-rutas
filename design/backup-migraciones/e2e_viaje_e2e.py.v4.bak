    assert card(p)['fase'] == 'esperando'
    s.limpio('plan borrado'); s.cerrar()



# ---------------------------------------------------------------------------------------------- tarjeta móvil, minimizable y ocultable
def rect(p, sel='#viajeCard'):
    return p.evaluate("(s) => { const r = document.querySelector(s).getBoundingClientRect(); return { x: r.x, y: r.y, w: r.width, h: r.height, r: r.right, b: r.bottom, vw: innerWidth, vh: innerHeight }; }", sel)


def arrastrar_tactil(p, x0, y0, x1, y1, pasos=10):
    cdp = p.context.new_cdp_session(p)
    cdp.send('Input.dispatchTouchEvent', {'type': 'touchStart', 'touchPoints': [{'x': x0, 'y': y0}]})
    for i in range(1, pasos + 1):
        cdp.send('Input.dispatchTouchEvent', {'type': 'touchMove', 'touchPoints': [{'x': x0 + (x1 - x0) * i / pasos, 'y': y0 + (y1 - y0) * i / pasos}]})
    cdp.send('Input.dispatchTouchEvent', {'type': 'touchEnd', 'touchPoints': []})
    p.wait_for_timeout(200)


def centro_asa(p):
    b = p.locator('#viajeAsa').bounding_box()
    return b['x'] + b['width'] / 2, b['y'] + b['height'] / 2


@prueba
def la_tarjeta_se_arrastra_con_el_raton_y_no_sale_de_la_pantalla(nav):
    s = sesion(nav)
    p = s.abrir()
    planear(p)
    iniciar(p)
    antes = rect(p)
    x, y = centro_asa(p)
    p.mouse.move(x, y); p.mouse.down(); p.mouse.move(x - 120, y - 90, steps=8); p.mouse.up()
    despues = rect(p)
    assert abs((despues['x'] - antes['x']) + 120) <= 2 and abs((despues['y'] - antes['y']) + 90) <= 2, (antes, despues)
    x, y = centro_asa(p)
    p.mouse.move(x, y); p.mouse.down(); p.mouse.move(2, 2, steps=8); p.mouse.up()
    lejos = rect(p)
    assert lejos['x'] >= 3 and lejos['y'] >= 55 and lejos['r'] <= lejos['vw'] and lejos['b'] <= lejos['vh'], f'nunca sale de la pantalla: {lejos}'
    x, y = centro_asa(p)
    p.mouse.move(x, y); p.mouse.down(); p.mouse.move(p.evaluate('innerWidth') - 1, p.evaluate('innerHeight') - 1, steps=8); p.mouse.up()
    lejos = rect(p)
    assert lejos['r'] <= lejos['vw'] + 0.5 and lejos['b'] <= lejos['vh'] + 0.5, lejos
    s.limpio('arrastrar con ratón'); s.cerrar()


@prueba
def la_tarjeta_se_arrastra_con_el_dedo_en_el_celular_sin_mover_el_mapa(nav):
    s = sesion(nav, **MOVIL)
    p = s.abrir()
    planear(p)
    iniciar(p)
    centro = p.evaluate("(() => { const c = Spevb.maps.map.getCenter(); return [c.lat, c.lng]; })()")
    antes = rect(p)
    x, y = centro_asa(p)
    arrastrar_tactil(p, x, y, x, y - 220)
    despues = rect(p)
    assert antes['y'] - despues['y'] >= 180, f'subió con el dedo: {antes} {despues}'
    assert despues['y'] >= 55 and despues['b'] <= despues['vh'], despues
    assert p.evaluate("(() => { const c = Spevb.maps.map.getCenter(); return [c.lat, c.lng]; })()") == centro, 'arrastrar la tarjeta no mueve el mapa de abajo'
    s.limpio('arrastrar con el dedo'); s.cerrar()


@prueba
def la_posicion_se_recuerda_doble_clic_la_devuelve_y_el_teclado_la_mueve(nav):
    s = sesion(nav)
    p = s.abrir()
    planear(p)
    iniciar(p)
    base = rect(p)
    p.focus('#viajeAsa')
    for _ in range(3):
        p.keyboard.press('ArrowLeft')
    p.keyboard.press('ArrowUp')
    mov = rect(p)
    assert abs((mov['x'] - base['x']) + 60) <= 1 and abs((mov['y'] - base['y']) + 20) <= 1, (base, mov)
    p.keyboard.press('Shift+ArrowLeft')
    assert abs((rect(p)['x'] - base['x']) + 120) <= 1, 'Shift mueve de 60 en 60'
    p.evaluate("Spevb.Viaje.detener()"); p.wait_for_timeout(200)
    iniciar(p)
    assert abs((rect(p)['x'] - base['x']) + 120) <= 1, 'un viaje nuevo conserva la posición que elegiste'
    p.dblclick('#viajeAsa')
    assert abs(rect(p)['x'] - base['x']) <= 1 and abs(rect(p)['y'] - base['y']) <= 1, 'doble clic: vuelve a su sitio'
    p.focus('#viajeAsa'); p.keyboard.press('ArrowRight'); p.keyboard.press('Home')
    assert abs(rect(p)['x'] - base['x']) <= 1, 'Inicio también'
    s.limpio('teclado y posición'); s.cerrar()


@prueba
def se_minimiza_a_una_barra_se_oculta_a_una_pastilla_y_las_preguntas_la_reabren(nav):
    s = sesion(nav, **MOVIL)
    p = s.abrir()
    planear(p)
    ls = lecturas(p)
    iniciar(p)
    i = alimentar(p, ls, 0, 'fase:esperando')
    completa = rect(p)
    p.click('#viajeMinimizar')
    c = rect(p)
    assert p.get_attribute('#viajeCard', 'data-modo') == 'compacta' and c['h'] < completa['h'] * 0.6 and c['h'] <= 110, (completa, c)
    assert p.is_visible('#viajeMini') and p.inner_text('#viajeMini') != '' and p.is_hidden('#viajeMasPanel') and p.is_hidden('.viaje-pie') and p.is_hidden('#viajeBarra')
    assert p.get_attribute('#viajeMinimizar', 'aria-expanded') == 'false' and p.get_attribute('#viajeMinimizar', 'aria-label') == 'Expandir la tarjeta del viaje'
    p.click('#viajeMinimizar')
    assert p.get_attribute('#viajeCard', 'data-modo') == 'completa' and abs(rect(p)['h'] - completa['h']) <= 2
    p.click('#viajeOcultar')
    assert p.is_hidden('#viajeCard') and p.is_visible('#viajePastilla') and 'Viaje' in p.inner_text('#viajePastilla')
    assert p.evaluate('Spevb.Viaje.activo()') and p.evaluate('window.__geo.escuchas') == 1, 'ocultar la tarjeta no detiene el viaje'
    pb = rect(p, '#viajePastilla')
    assert pb['h'] >= 43.5 and pb['r'] <= pb['vw'] and pb['b'] <= pb['vh'], pb
    p.click('#viajePastilla')
    assert p.is_visible('#viajeCard') and p.is_hidden('#viajePastilla') and p.get_attribute('#viajeCard', 'data-modo') == 'compacta'
    p.click('#viajeOcultar')                                                     # oculta de nuevo y sigue el viaje: la pregunta de subida la reabre
    i = alimentar(p, ls, i, 'pregunta')
    c = card(p)
    assert p.is_visible('#viajeCard') and p.is_hidden('#viajePastilla') and p.get_attribute('#viajeCard', 'data-modo') == 'completa' and c['pregunta'], c
    p.click('#viajeSi')
    p.click('#viajeMinimizar')                                                   # minimizada: la alerta urgente también la abre
    alimentar(p, ls, i, 'alerta:urgente')
    assert p.get_attribute('#viajeCard', 'data-modo') == 'completa' and '¡Bájate ahora!' in (card(p)['aviso'] or '')
    s.limpio('minimizar y ocultar'); s.cerrar()


@prueba
def la_tarjeta_por_defecto_deja_ver_gran_parte_del_mapa(nav):
    for nombre, op, tope in (('384x848', MOVIL, 0.30), ('320x568', {'viewport': {'width': 320, 'height': 568}, 'is_mobile': True, 'has_touch': True}, 0.42)):
        s = sesion(nav, **op)
        p = s.abrir()
        planear(p)
        iniciar(p)
        r = rect(p)
        assert r['h'] <= r['vh'] * tope, f'{nombre}: la tarjeta ocupa {r["h"] / r["vh"]:.0%} de la pantalla: {r}'
        s.limpio(nombre); s.cerrar()


@prueba
def iniciar_viaje_es_el_boton_principal_justo_bajo_buscar_rutas_y_queda_a_la_vista(nav):
    for nombre, op in (('384x848', MOVIL), ('320x568', {'viewport': {'width': 320, 'height': 568}, 'is_mobile': True, 'has_touch': True}), ('escritorio', {'viewport': {'width': 1280, 'height': 860}})):
        s = sesion(nav, **op)
        p = s.abrir()
        assert p.is_hidden('#startTripBar') and p.is_hidden('#startTrip'), f'{nombre}: sin viaje calculado no hay botón'
        assert p.evaluate("document.querySelector('#planTrip').closest('.plan-actions').nextElementSibling.id") == 'startTripBar', f'{nombre}: va justo debajo de «Buscar rutas»'
        planear(p)
        assert p.is_visible('#startTripBar') and 'Ruta M01' in p.inner_text('#startTripInfo')
        b = rect(p, '#startTrip')
        panel = rect(p, '#startTripBar')
        assert b['h'] >= 50 and b['w'] >= panel['w'] * 0.85, f'{nombre}: es grande y de ancho completo: {b}'
        assert b['y'] >= 0 and b['b'] <= b['vh'], f'{nombre}: se ve sin desplazar la pantalla: {b}'
        p.evaluate("document.querySelector('.sheet-body').scrollTop = 600"); p.wait_for_timeout(300)
        b2 = rect(p, '#startTrip')
        assert b2['y'] >= 0 and b2['b'] <= b2['vh'], f'{nombre}: se queda a la vista mientras se recorren los resultados: {b2}'
        iniciar(p)
        assert p.is_disabled('#startTrip') and p.inner_text('#startTripInfo') == 'Sigue las indicaciones de la tarjeta del mapa', f'{nombre}: durante el viaje queda como «Viaje en curso»'
        p.evaluate("Spevb.Viaje.detener()"); p.wait_for_timeout(200)
        assert p.is_enabled('#startTrip') and p.is_visible('#startTripBar')
        p.click('#clearTripPoints'); p.wait_for_timeout(300)
        assert p.is_hidden('#startTripBar'), f'{nombre}: al limpiar A y B desaparece'
        s.limpio(nombre); s.cerrar()


@prueba
def tras_buscar_el_panel_no_baja_solo_aunque_el_ajuste_viejo_estuviera_activado_y_ver_otras_opciones_abre_la_lista(nav):
    s = sesion(nav, **MOVIL)
    # un celular que ya usó la app: la clave vieja `panelAuto` quedó guardada como «activada»; ya no debe esconder el botón de inicio
    s.ctx.add_init_script("try { const a = JSON.parse(localStorage.getItem('spevb-ajustes') || '{}'); a.panelAuto = true; localStorage.setItem('spevb-ajustes', JSON.stringify(a)); } catch (e) {}")
    p = s.abrir()
    assert p.evaluate("Spevb.Ajustes.get('panelBajar')") is False, 'bajar el panel solo viene apagado por defecto'
    planear(p)
    p.wait_for_timeout(2600)                                                # más que los 1,1 s con los que antes bajaba solo
    assert not p.evaluate("document.body.classList.contains('panel-oculto')"), 'el panel se queda a la vista'
    assert p.evaluate("document.getElementById('sheet').dataset.state") == 'peek'
    b = rect(p, '#startTrip')
    assert b['y'] >= 0 and b['b'] <= b['vh'] and p.inner_text('#startTripInfo').startswith('Ruta M01 · '), f'«Iniciar viaje» con su resumen a la vista: {b}'
    assert p.is_visible('#verOpciones') and p.inner_text('#verOpciones').startswith('Ver otras opciones · ')
    p.click('#verOpciones')
    B.esperar(p, "document.getElementById('sheet').dataset.state === 'half'", 5000)
    p.wait_for_timeout(500)
    t = rect(p, '#tripResults')
    assert t['y'] < t['vh'] * 0.9, f'la lista de rutas queda a la vista: {t}'
    s.limpio('flujo directo'); s.cerrar()


@prueba
def el_bus_de_demostracion_se_pausa_durante_el_viaje_y_vuelve_al_terminar(nav):
    s = sesion(nav)
    p = s.abrir()
    planear(p)
    assert p.evaluate("document.querySelectorAll('.bus-wrapper').length") == 1 and p.is_visible('.bus-panel')
    iniciar(p)
    assert p.evaluate("document.querySelectorAll('.bus-wrapper').length") == 0 and p.is_hidden('.bus-panel'), 'durante el viaje no hay bus animado ni sus controles'
    # el plan cambia durante el viaje: el bus NO reaparece encima de la tarjeta
    p.evaluate("Spevb.Planner.seleccion && document.querySelectorAll('#tripResults .trip-option')[1] && document.querySelectorAll('#tripResults .trip-option > summary')[1].click()")
    p.wait_for_timeout(1500)
    assert p.evaluate("document.querySelectorAll('.bus-wrapper').length") == 0, 'seguir tocando tarjetas no lo reactiva'
    p.evaluate("Spevb.Viaje.detener()"); p.wait_for_timeout(500)
    assert p.evaluate("document.querySelectorAll('.bus-wrapper').length") == 1 and p.is_visible('.bus-panel'), 'al terminar el viaje vuelve'
    s.limpio('bus durante el viaje'); s.cerrar()


def correr(filtro=None):
    fallos = []
    with sync_playwright() as p:
        nav = B.navegador(p)
        print('Navegador:', nav.browser_type.name, nav.version, '| URL:', B.URL)
        for f in PRUEBAS:
            if filtro and filtro not in f.__name__:
                continue
            try:
                f(nav)
                print('OK    ', f.__name__)
            except Exception as e:  # noqa: BLE001
                fallos.append(f.__name__)
                print('FALLA ', f.__name__, '|', str(e).splitlines()[0][:700] if str(e) else repr(e))
                traceback.print_exc(limit=3)
        nav.close()
    print(f'\n{len(PRUEBAS) if not filtro else "?"} pruebas de interfaz del modo viaje; fallos: {len(fallos)} {fallos}')
    return 1 if fallos else 0


if __name__ == '__main__':
    sys.exit(correr(sys.argv[1] if len(sys.argv) > 1 else None))
